# Ignore everything by default
*

# Allow only these directories and files to be tracked
!Thunar/
!autostart/
!hypr/
!kitty/
!spotify-player/
!waybar/
!wlogout/
!wofi/
!.yadm.gitignore
!mimeapps.list
!pavucontrol.ini

# Always ignore these patterns even in allowed directories
*.tmp
*.temp
*.save
*.swp
*.swo
*.backup
*.old
*~
.DS_Store
*.log
*.cache

