// Archipelago: floating-island Waybar profile.
// Started by ~/.config/hypr/scripts/waybar-profile.sh (SUPER+SHIFT+B toggles).
{
  "layer": "top",
  "position": "top",
  "height": 30,
  "margin-top": 8,
  "margin-left": 8,
  "margin-right": 8,
  "spacing": 0,

  "modules-left": ["group/brand", "mpris"],
  // The centre holds only the clock, so it stays exactly centred.
  "modules-center": ["clock"],
  "modules-right": ["group/utility", "group/status"],

  // ---------- brand island: Arch logo + this screen's workspace dots ----------

  "group/brand": {
    "orientation": "horizontal",
    "modules": ["custom/logo", "hyprland/workspaces"]
  },

  "custom/logo": {
    "format": "",
    "tooltip": false,
    // Scrolling anywhere on the island steps through workspaces, like on the dots.
    "on-scroll-up": "hyprctl dispatch workspace m+1",
    "on-scroll-down": "hyprctl dispatch workspace m-1"
  },

  // Dots are drawn by style.css; the buttons carry no text.
  "hyprland/workspaces": {
    "all-outputs": false,
    "format": "",
    // m±1 stays on this screen, matching the per-screen dots.
    "on-scroll-up": "hyprctl dispatch workspace m+1",
    "on-scroll-down": "hyprctl dispatch workspace m-1"
  },

  // ---------- media island: hidden while no player runs ----------

  // Click and right-click keep the module's defaults: play/pause and next track.
  "mpris": {
    "format": "{player_icon} {dynamic}",
    "dynamic-order": ["artist", "title"],
    "dynamic-separator": " – ",
    "max-length": 40,
    "tooltip-format": "{player}: {artist} – {title}",
    "player-icons": {
      "default": "",
      "spotify": "",
      "spotify_player": ""
    },
    "ignored-players": ["firefox", "brave", "chromium"]
  },

  // ---------- clock island ----------

  "clock": {
    "format": "{:%H:%M · %a %d %b}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      // Pango markup can't use the GTK palette names, so these are Mocha hex values:
      // mauve, text, blue, green.
      "format": {
        "months": "<span color='#cba6f7'><b>{}</b></span>",
        "days": "<span color='#cdd6f4'>{}</span>",
        "weekdays": "<span color='#89b4fa'><b>{}</b></span>",
        "today": "<span color='#a6e3a1'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  // ---------- utility island: tray + two launchers ----------

  "group/utility": {
    "orientation": "horizontal",
    "modules": ["tray", "custom/clipboard", "custom/tcc"]
  },

  "tray": {
    "icon-size": 16,
    "spacing": 10
  },

  "custom/clipboard": {
    "format": "󰅇",
    "tooltip-format": "Clipboard history (right-click wipes it)",
    "on-click": "cliphist list | wofi --dmenu | cliphist decode | wl-copy",
    "on-click-right": "cliphist wipe"
  },

  "custom/tcc": {
    "format": "󰈐",
    "tooltip-format": "TUXEDO Control Center",
    "on-click": "tuxedo-control-center"
  },

  // ---------- status island: drawer, network, volume, battery ----------

  "group/status": {
    "orientation": "horizontal",
    "modules": ["group/system", "network", "pulseaudio", "battery"]
  },

  // Hover the temperature to slide out CPU and memory.
  "group/system": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 300,
      "children-class": "drawer-child"
    },
    "modules": ["temperature", "cpu", "memory"]
  },

  // k10temp's Tctl, found through the driver's own sysfs directory, so it
  // doesn't depend on the hwmonN number, which changes between boots.
  "temperature": {
    "hwmon-path-abs": "/sys/bus/pci/drivers/k10temp/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 85,
    "interval": 5,
    "format": "󰔏",
    "format-critical": "󰔏 {temperatureC}°C",
    "tooltip-format": "CPU {temperatureC}°C"
  },

  "cpu": {
    "format": "󰻠 {usage}%",
    "interval": 5
  },

  "memory": {
    "format": "󰍛 {percentage}%",
    "interval": 5
  },

  "network": {
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-linked": "󰈀",
    "format-disconnected": "󰤮",
    "format-disabled": "󰤮",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format-wifi": "{essid} · {signalStrength}%\n{ipaddr}/{cidr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "nm-connection-editor"
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "tooltip-format": "{volume}%",
    "on-scroll-up": "pamixer --increase 5",
    "on-scroll-down": "pamixer --decrease 5",
    "on-click": "pavucontrol",
    "on-click-right": "pamixer --toggle-mute"
  },

  "battery": {
    "bat": "BAT0",
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "format-time": "{H} h {M} min",
    "tooltip-format": "{time} remaining",
    "tooltip-format-charging": "{time} until full",
    "tooltip-format-full": "Fully charged",
    "tooltip-format-plugged": "Plugged in, not charging"
  }
}
